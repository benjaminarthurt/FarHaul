{
  "schema_version": "0.1.0",
  "canon_status": "draft",
  "source_of_truth": true,
  "principles": [
    "Customs is administered by each system government; ports execute local policy.",
    "Customs knows declarations, inspections and records available to it, not hidden cargo by fiat.",
    "Legal cargo can still require declaration, duties, quarantine, biosecurity or permits.",
    "Smuggling is an act of concealment or false declaration, not a special cargo category."
  ],
  "clearance_states": [
    "prearrival_filed",
    "awaiting_clearance",
    "cleared",
    "secondary_inspection",
    "cargo_hold",
    "vessel_hold"
  ],
  "declaration_fields": [
    "vessel_registry_id",
    "origin_system_id",
    "last_port_id",
    "crew_and_passengers",
    "cargo_items",
    "cargo_owner",
    "declared_value",
    "hazard_classes",
    "biological_origin",
    "permits"
  ],
  "inspection_methods": [
    {
      "id": "document_check",
      "detects": [
        "manifest_mismatch",
        "permit_failure",
        "known_identity_flags"
      ],
      "intrusiveness": 0.1
    },
    {
      "id": "mass_balance",
      "detects": [
        "undeclared_mass",
        "false_quantity"
      ],
      "intrusiveness": 0.25
    },
    {
      "id": "container_scan",
      "detects": [
        "concealed_compartments",
        "density_anomaly",
        "undeclared_hazard"
      ],
      "intrusiveness": 0.45
    },
    {
      "id": "atmospheric_trace",
      "detects": [
        "chemical_residue",
        "biological_trace"
      ],
      "intrusiveness": 0.35
    },
    {
      "id": "physical_search",
      "detects": [
        "concealed_cargo",
        "false_compartment",
        "tampered_seal"
      ],
      "intrusiveness": 0.9
    },
    {
      "id": "crew_interview",
      "detects": [
        "document_inconsistency",
        "identity_issue"
      ],
      "intrusiveness": 0.5
    }
  ],
