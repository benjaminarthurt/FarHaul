{
  "schema_version": "0.1.0",
  "canon_status": "draft",
  "currency": "cr",
  "rating_model": {
    "billing_period_days": 30,
    "formula": "insured_value * base_rate * hull_factor * region_factor * history_factor * configuration_factor",
    "notes": "Implementation may simplify this formula while preserving the same inputs."
  },
  "products": [
    {
      "id": "hull_basic",
      "name": "Basic Hull",
      "covers": [
        "collision",
        "fire",
        "major machinery casualty"
      ],
      "base_rate_per_30_days": 0.0028,
      "default_deductible_fraction": 0.08,
      "typical_exclusions": [
        "unsupported_frontier",
        "war_or_deliberate_damage",
        "undeclared_major_modification"
      ]
    },
    {
      "id": "hull_comprehensive",
      "name": "Comprehensive Hull",
      "covers": [
        "collision",
        "fire",
        "major machinery casualty",
        "salvage expense",
        "some environmental damage"
      ],
      "base_rate_per_30_days": 0.0042,
      "default_deductible_fraction": 0.04,
      "typical_exclusions": [
        "undeclared_major_modification",
        "fraud"
      ]
    },
    {
      "id": "carrier_liability",
      "name": "Carrier Liability",
      "covers": [
        "third_party_property",
        "cargo_handling_liability",
        "docking_damage"
      ],
      "base_rate_per_30_days": 0.0012,
      "default_deductible_fraction": 0.02,
      "typical_exclusions": [
        "prohibited_cargo",
        "intentional_damage"
      ]
    },
    {
      "id": "cargo_cover",
      "name": "Cargo Cover",
      "covers": [
        "insured_cargo_loss",
        "insured_cargo_damage"
      ],
      "base_rate_per_30_days": 0.0018,
      "default_deductible_fraction": 0.03,
      "typical_exclusions": [
        "improper_declared_handling",
        "prohibited_cargo"
      ]
    },
    {
      "id": "passenger_liability",
      "name": "Passenger Liability",
      "covers": [
        "passenger_injury_liability",
        "passenger_property"
      ],
      "base_rate_per_30_days": 0.0015,
      "default_deductible_fraction": 0.02,
      "typical_exclusions": [
        "uncertified_habitation",
        "unlicensed_operation"
      ]
    },
    {
      "id": "environmental_liability",
      "name": "Environmental Liability",
      "covers": [
        "regulated_release_cleanup",
        "third_party_environmental_damage"
      ],
      "base_rate_per_30_days": 0.0022,
      "default_deductible_fraction": 0.05,
      "typical_exclusions": [
        "undeclared_hazardous_cargo",
        "intentional_release"
      ]
    },
    {
      "id": "frontier_endorsement",
      "name": "Frontier Endorsement",
      "covers": [
        "specified_routes_beyond_standard_support"
      ],
      "base_rate_per_30_days": 0.0035,
      "default_deductible_fraction": 0.1,
      "typical_exclusions": [
        "unfiled_route_when_required",
        "insufficient_declared_reserves"
      ]
    }
  ],
  "hull_factors": {
    "small_freighter": 0.85,
    "medium_freighter": 1,
    "large_freighter": 1.15,
    "heavy_freighter": 1.35,
    "superheavy_freighter": 1.65
  },
  "region_factors": {
    "core": 0.85,
    "developed": 1,
    "outer": 1.2,
    "frontier": 1.55,
    "unsupported": 2.4
  },
  "history_factors": {
    "excellent": 0.78,
    "good": 0.9,
    "standard": 1,
    "poor": 1.3,
    "cancelled_policy_history": 1.7
  },
  "certificate_requirements": {
    "high_value_contract": {
      "required_products": [
        "carrier_liability",
        "cargo_cover"
      ]
    },
    "passenger": {
      "required_products": [
        "passenger_liability"
      ]
    },
    "hazardous": {
      "required_products": [
        "carrier_liability"
      ],
      "conditional_products": [
        "environmental_liability"
      ]
    },
    "government_survey": {
      "required_products": [
        "carrier_liability"
      ],
      "conditional_products": [
        "frontier_endorsement"
      ]
    },
    "financed_ship": {
      "required_products": [
        "hull_basic"
      ],
      "acceptable_upgrade": "hull_comprehensive"
    }
  },
  "claim_rules": [
    "A policy violation unrelated to a loss does not automatically erase every form of coverage.",
    "A materially related exclusion can reduce or deny a claim.",
    "Fraud or deliberately false certificate information can trigger cancellation and broader denial according to policy terms."
  ],
  "design_notes": [
    "Insurance should create meaningful recurring cost and unlock commerce, not become a mandatory tax.",
    "Players can self-insure by carrying no policy when counterparties allow it.",
    "Exact premium numbers are balance data and should remain tunable."
  ]
}
