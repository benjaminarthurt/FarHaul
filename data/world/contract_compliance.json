  "requirement_resolution_order": [
    "Port minimum access rules must be satisfied to enter/use the facility.",
    "Contract issuer registration requirements are checked.",
    "Cargo/activity endorsements and insurance certificates are checked.",
    "Lender requirements apply independently to the vessel.",
    "Policy restrictions are checked for insurer exposure but do not physically block acceptance unless certificate validation reveals the conflict."
  ],
  "contract_classes": [
    {
      "id": "ordinary_bulk",
      "registration": "recognized_current_preferred",
      "insurance_required": [],
      "can_offer_to_unregistered": true,
