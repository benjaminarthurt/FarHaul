      "can_offer_to_unregistered": false,
      "notes": "Routine reputable commercial work."
    },
    {
      "id": "high_value",
      "registration": "recognized_current",
      "insurance_required": [
        "carrier_liability",
        "cargo_cover"
      ],
      "can_offer_to_unregistered": false,
