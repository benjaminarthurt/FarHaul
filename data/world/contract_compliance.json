        "cargo_specific_hazard_endorsement"
      ],
      "notes": "Terminal or commodity can elevate environmental coverage to required."
    },
    {
      "id": "scientific_sensitive",
      "registration": "recognized_current",
      "insurance_required": [
        "carrier_liability",
        "cargo_cover"
      ],
      "can_offer_to_unregistered": false,
      "required_ship_endorsements": [
        "handling_requirements_met"
      ],
      "notes": "Sterility, vibration, temperature or security requirements can be added per cargo."
    },
    {
      "id": "government",
      "registration": "recognized_current",
      "insurance_required": [
        "carrier_liability"
      ],
      "can_offer_to_unregistered": false,
      "notes": "Individual system governments can add requirements."
    },
    {
      "id": "government_survey",
      "registration": "recognized_current",
      "insurance_required": [
